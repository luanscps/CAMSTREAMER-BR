<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- PREVIEW -->
    <com.pedro.library.view.OpenGlView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- GRID OVERLAY (regra dos terços) — ativado com long-press no preview -->
    <com.camera2rtsp.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- BARRA SUPERIOR: badge LIVE + URL RTMP + bateria -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/rtspBadge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:paddingHorizontal="8dp"
            android:gravity="center"
            android:text="OFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_badge_green"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="rtmp://..."
            android:textSize="10sp"
            android:textColor="#94a3b8"
            android:fontFamily="monospace"
            android:singleLine="true" />

        <!-- clientsBadge mantido no código mas invisível — evita NPE no tickHud -->
        <TextView
            android:id="@+id/clientsBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="0 CLI"
            android:textSize="10sp"
            android:textColor="#64748b"
            android:fontFamily="monospace"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textSize="10sp"
            android:textColor="#94a3b8"
            android:fontFamily="monospace"
            android:layout_marginStart="10dp" />

    </LinearLayout>

    <!-- HUD invisível — mantido no código, escondido na UI -->
    <LinearLayout
        android:id="@+id/hudLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:visibility="gone"
        android:orientation="vertical">
        <TextView android:id="@+id/hudResolution" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1920x1080" android:textSize="11sp" android:textColor="#f8fafc" android:fontFamily="monospace"/>
        <TextView android:id="@+id/hudFps"        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 fps"    android:textSize="11sp" android:textColor="#94a3b8" android:fontFamily="monospace"/>
        <TextView android:id="@+id/hudBitrate"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4000 kbps" android:textSize="11sp" android:textColor="#94a3b8" android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- BARRA INFERIOR: só o botão STREAM + botão Settings -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="#EE0a0a0a"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Botão STREAM (shutter) centralizado -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center">

                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_shutter_ring" />

                <View
                    android:id="@+id/btnShutter"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_inner" />

            </FrameLayout>
        </FrameLayout>

        <!-- Botão Settings (engrenagem) à direita -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_action_btn"
            android:src="@android:drawable/ic_menu_manage"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="Configuracoes" />

        <!-- Views fantasmas para não quebrar o MainActivity.kt -->
        <ImageButton android:id="@+id/btnFlashToggle"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="flash"/>
        <ImageButton android:id="@+id/btnSwitchCamera"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="switch"/>
        <ImageButton android:id="@+id/btnPreviewToggle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="preview"/>
        <LinearLayout android:id="@+id/lensContainer"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:orientation="horizontal"/>

    </LinearLayout>

    <!-- paramsBar fantasma — evita NPE no cleanUI -->
    <HorizontalScrollView
        android:id="@+id/paramsBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- dials fantasmas para não quebrar bindViews() -->
            <include layout="@layout/item_param_dial" android:id="@+id/paramIso"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <include layout="@layout/item_param_dial" android:id="@+id/paramShutter" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <include layout="@layout/item_param_dial" android:id="@+id/paramWb"      android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <include layout="@layout/item_param_dial" android:id="@+id/paramFocus"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <include layout="@layout/item_param_dial" android:id="@+id/paramZoom"    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- PAINEL LATERAL de configurações -->
    <include
        android:id="@+id/settingsPanel"
        layout="@layout/layout_settings_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:translationX="280dp"
        android:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
